{
  "name": "silknet",
  "displayName": "Silknet",
  "description": "Connect Browser AI to Local AI — Multi-Tab Consensus, Voice Prompting & File Attachments",
  "version": "1.1.0",
  "publisher": "silknet",
  "license": "MIT",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jack4z1/silknet.git"
  },
  "homepage": "https://github.com/jack4z1/silknet",
  "bugs": {
    "url": "https://github.com/jack4z1/silknet/issues"
  },
  "keywords": [
    "ai",
    "chatgpt",
    "claude",
    "gemini",
    "browser-bridge",
    "local-ai",
    "consensus",
    "ollama"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["AI", "Machine Learning", "Programming Languages"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tab-bridge-container",
          "title": "Silknet v1.1",
          "icon": "icons/bridge.svg"
        }
      ]
    },
    "views": {
      "tab-bridge-container": [
        {
          "type": "webview",
          "id": "tabBridge.masterView",
          "name": "Silknet Consensus Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "tabBridge.consensusAI",
        "title": "Silknet: Multi-Tab AI Consensus (Browser AIs -> Local AI)",
        "category": "Silknet"
      },
      {
        "command": "tabBridge.askAI",
        "title": "Silknet: Ask Browser AI",
        "category": "Silknet"
      },
      {
        "command": "tabBridge.sendSelection",
        "title": "Silknet: Send Selected Code to Browser AI",
        "category": "Silknet"
      },
      {
        "command": "tabBridge.checkStatus",
        "title": "Silknet: Check Connected AI Tabs Status",
        "category": "Silknet"
      }
    ],
    "keybindings": [
      {
        "command": "tabBridge.consensusAI",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "tabBridge.askAI",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "tabBridge.sendSelection",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.6.0"
  }
}
